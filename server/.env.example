# Postgres connection string from your hosted provider (Neon, Supabase, RDS, etc).
# Must include sslmode=require for most managed providers.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# The client's origin, for CORS. Vite's dev server default is shown.
CLIENT_ORIGIN=http://localhost:5173

PORT=5000
NODE_ENV=development
